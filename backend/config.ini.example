[security]
# A secret key required for all API access.
# This can also be set via the TORDB_API_KEY environment variable.
api_key = your_secret_api_key

[tmdb]
api_key = your_api_key_here

[database]
# Database type: sqlite or mysql
type = sqlite
host = localhost
port = 3306
user = user
password = password
dbname = tordb